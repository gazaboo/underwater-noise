// La carte du vacarme — configuration par défaut.
//
// Ce fichier est la référence : chaque paramètre y est commenté.
// Surcharges, dans l'ordre : config/expo.json5 (si VACARME_MODE=expo), puis
// config/local.json5 (écrit par le panneau de réglage, ignoré par git).
// Le serveur recharge ces fichiers à chaud : modifiez, enregistrez, l'image suit.
{
  display: {
    // Cible d'affichage : "screen" (écran du portable) ou "projector" (Epson EB-990U).
    // Surchargeable par l'URL : ?display=projector
    target: 'screen',
    // Mode de rendu. J1 : carte plate uniquement ; le globe et la demi-sphère arrivent au J6.
    mode: 'flat',
    // Profil de qualité (voir qualityProfiles). Surchargeable par l'URL : ?quality=light
    quality: 'expo',
  },

  qualityProfiles: {
    // Radeon 780M : 60 images/s visées en 1920×1200 comme en 2256×1504.
    expo: { visualSimWidth: 2048, visualSimSteps: 3, detailSimWidth: 1024, physicsSimWidth: 1024 },
    light: { visualSimWidth: 1536, visualSimSteps: 2, detailSimWidth: 768, physicsSimWidth: 768 },
  },

  view: {
    flat: {
      centerLon: 30, // de la côte est américaine à la mer de Chine (en 3:2, 'cover' montre ~210° de longitude)
      latMin: -62, // on coupe l'océan Austral profond et l'Antarctique…
      latMax: 78, // …et la banquise arctique
      fit: 'cover', // 'cover' remplit l'écran (rogne les bords en longitude), 'contain' montre tout
    },
    // Exploration : molette = zoom, glisser = déplacer, double-clic ou R = recadrer.
    // Au-delà de minZoom, une grille d'ondes fine couvre la zone visible (marge comprise).
    detail: { enabled: true, minZoom: 2.5, margin: 1.35 },
  },

  // Rendu final (communs aux deux cibles, puis surchargés dans `targets`).
  render: {
    renderScale: 0.75, // fraction de la résolution native (les ondes sont douces : l'agrandissement ne se voit pas)
    exposure: 1.0,
    gamma: 1.0,
    blackLift: 0.0, // relève le noir (0–1)
    vignette: 0.25,
    dither: true, // évite les bandes dans les dégradés sombres
  },

  // Palette : fond noir profond, lumière froide pour les ondes.
  palette: {
    background: '#000000',
    oceanShallow: '#030a10',
    oceanDeep: '#000102',
    bathyRelief: 0.4, // relief du fond marin, à peine perceptible
    land: '#000000',
    coast: '#1b2a36',
    coastOpacity: 0.55,
    unknownDim: 0.4, // zones jamais observées par l'AIS : dans l'ombre (terra incognita)
    glow: '#5f9fc4', // lueur d'accumulation : là où le bruit dure, l'océan s'illumine
    fog: '#0b1117', // brouillard de la terra incognita : plus sombre que le calme connu, mais texturé
    wave: '#cfeaff',
    ship: '#e8f4ff',
  },

  // Surcharges propres à chaque cible.
  targets: {
    // Écran du portable (IPS, vrai noir) : on peut descendre bas dans les noirs.
    screen: {
      render: { vignette: 0.3, blackLift: 0.0 },
    },
    // Projecteur LCD à lampe : noir gris ; pas de vignettage (géré par le masque du disque au J6).
    projector: {
      render: { renderScale: 1.0, vignette: 0.0, gamma: 1.1 },
      view: { flat: { fit: 'contain' } },
    },
  },

  // Ondes visibles (grille visuelle). Paramètres purement artistiques.
  waves: {
    courant: 0.45, // vitesse des fronts (cellules par pas à l'équateur) ; max stable ≈ 0,67
    damping: 0.016, // persistance : plus petit = fronts qui voyagent plus loin (0,004 : tout l'océan sature)
    coastDamping: 0.35, // 0 = côtes réfléchissantes, 1 = côtes absorbantes
    polarCapLat: 79, // au-delà : banquise (mur)
    pulse: {
      wavelengthCells: 7, // longueur d'onde des fronts (cellules)
      cycles: 1.5, // cycles par impulsion : 1 à 2 donnent des anneaux nets
      rate: 0.35, // impulsions par seconde pour un navire de référence
      gain: 0.8,
    },
    amplitude: {
      slMin: 166, // niveau source large bande (dB re 1 µPa·m) qui donne une amplitude nulle
      slMax: 192, // niveau qui donne l'amplitude maximale
      gamma: 1.7, // compression : seuls les navires bruyants marquent fortement
    },
    brightness: 2.8,
    shallowSpeed: 0.6, // réfraction : les fronts ralentissent et se courbent sur les plateaux (1 = aucun effet)
    relief: 0.25, // part de l'éclairage « relief » (reflets) dans le rendu des ondes
  },

  ships: {
    visible: true,
    pointSize: 2.2, // en pixels CSS
    opacity: 0.7,
  },

  // Bandes d'analyse acoustique (Hz) — utilisées par le champ physique (J3).
  // naturalDb : bruit ambiant naturel (vent, vagues, turbulence) dans la bande, sans navires —
  // ordres de grandeur d'après les courbes de Wenz pour un état de mer ~3 (dB re 1 µPa, niveau de bande).
  bands: [
    { id: 'low', fMin: 10, fMax: 40, naturalDb: 88 }, // rorqual bleu, rorqual commun
    { id: 'mid', fMin: 100, fMax: 500, naturalDb: 88 }, // baleine à bosse
    { id: 'high', fMin: 1000, fMax: 10000, naturalDb: 92 }, // orque, cachalot
  ],

  // Champ de bruit physique : grille calibrée en dB (voir docs/MODELE_PHYSIQUE.md).
  physics: {
    enabled: true,
    energyTauSec: 6, // moyenne de l'énergie : lisse les fluctuations des sources
    bottomLoss: 0.08, // eau très peu profonde : la bande basse ne se propage plus (coupure modale)
    shallowLossDbPerKm: 0.01, // perte générique sur le plateau continental (< 200 m)
    // Correction empirique : l'étalement purement cylindrique (10·log r) surestime le bruit loin des
    // sources (≈ +5 à 10 dB à 2 000 km). 0,004 dB/km retire ~8 dB sur 2 000 km. 0 = modèle pur.
    extraLossDbPerKm: 0.004,
  },

  // Accumulation : l'océan se « sature » progressivement là où le trafic dure.
  accumulation: {
    bandWeights: { low: 0.45, mid: 0.4, high: 0.15 },
    quietDb: 95, // sous ce niveau, noir (le bruit naturel est vers 88–92 dB)
    saturationDb: 125, // pleine lueur
    gamma: 1.3,
    riseMinutes: 2, // la saturation s'installe en quelques minutes
    fallMinutes: 20, // et s'efface lentement : l'océan garde la trace
    strength: 0.9,
  },

  // Terra incognita : zones où l'AIS ne voit rien. Matière propre, distincte du calme connu.
  incognita: {
    fog: 0.7, // brouillard lent (sa couleur reste très sombre : palette.fog)
    scaleDeg: 9,
    drift: 0.6,
    grain: 0.25, // grain fin, visible même au projecteur (noir gris)
    waveKeep: 0.35, // les ondes y entrent, mais s'y estompent : on entend sans voir
  },

  // Mode simulation (navires synthétiques sur les routes maritimes).
  simulation: {
    shipCount: 5000,
    timeScale: 20, // temps simulé / temps réel : 20 → un navire à 15 nœuds traverse l'Atlantique en ~8 h
    fishingFraction: 0.12, // part de navires de pêche (errance près des côtes)
    laneWidthKm: 25, // dispersion latérale autour des routes
    seed: 42,
  },

  // Choix de la source de navires.
  source: {
    mode: 'auto', // 'auto' : direct (aisstream) si possible, sinon replay, sinon simulation
    liveSilenceSec: 60, // silence du direct avant bascule
    liveRecoverSec: 20, // bonne santé requise avant de revenir au direct
    liveMinShips: 300, // au démarrage, on attend d'avoir assez de navires avant d'afficher le direct
    hybrid: false, // navires simulés dans les zones non couvertes : désactivé, cela « invente » des données
    hybridCoverageThreshold: 0.15,
  },

  // AIS en direct (aisstream.io). La clé se lit dans .env : AISSTREAM_API_KEY=…
  live: {
    url: 'wss://stream.aisstream.io/v0/stream',
    staleAfterMin: 10, // au-delà : position extrapolée, marquée « ancienne »
    maxExtrapolateMin: 30, // extrapolation à l'estime au plus 30 min (couverture côtière : un navire qui sort de portée continue sa route)
    evictAfterMin: 180, // oubli après 3 h sans nouvelles
    includeMoored: false, // les navires à quai sont presque silencieux : non envoyés au rendu
  },

  // Replay de fichiers enregistrés (.ndjson.gz) — enregistrements du serveur ou archives converties (tools/convert_ais.py).
  replay: {
    path: 'data/replays', // fichier ou dossier ; pour rejouer vos propres enregistrements : 'data/recordings'
    speed: 10, // ×10 : une heure d'archive en 6 minutes
    loop: true,
  },

  // Enregistrement du flux direct, pour le rejouer le jour de l'exposition.
  recorder: {
    enabled: true,
    dir: 'data/recordings', // un fichier par heure : AAAA-MM-JJ/HH.ndjson.gz
    minIntervalSec: 30, // une position par navire toutes les 30 s au plus (≈ 1/10 du volume brut)
  },

  // Carte de couverture AIS (où l'on « voit » des navires).
  coverage: {
    halfLifeHours: 12, // mémoire : une zone non revue depuis 12 h perd la moitié de son score
    gainPerMessage: 0.25,
    simulation: 'full', // en simulation : 'full' (tout observé) ou 'recorded' (dernière couverture réelle)
  },

  // Cétacés (J4) : groupes simulés dans leurs habitats (AquaMaps), espace de communication
  // (équation du sonar, bruit local) et liens entre groupes. Valeurs acoustiques : ordres de
  // grandeur de la littérature (Richardson et al. 1995 ; Clark et al. 2009 ; Erbe et al. 2016).
  whales: {
    enabled: true,
    timeScale: 30, // les groupes se déplacent 30 fois plus vite qu'en vrai (sinon immobiles à l'œil)
    habitatThreshold: 0.35,
    useSightings: true,
    color: '#f2dcc2', // teinte chaude et pâle : le vivant, distinct de la lumière froide du bruit
    space: {
      fill: 0.09, // remplissage de l'espace de communication
      contour: 0.6, // contour (là où l'appel cesse d'être audible)
      softnessDb: 10, // fondu du remplissage vers le contour
      markerSize: 6, // point du groupe (pixels CSS) ; il s'illumine à chaque appel
    },
    links: {
      enabled: true,
      hysteresisDb: 2, // pas de clignotement autour du seuil
      breakSec: 5, // le fil s'effiloche puis s'éteint en quelques secondes
      reknitSec: 14, // il se retisse plus lentement
      ghostSec: 180, // trace fantôme du lien perdu
      intensity: 0.9,
      ghost: 0.12,
      pulseSpeed: 0.3, // l'appel parcourt le fil en ~3 s
    },
    species: [
      // band : bande du champ physique ; sl : niveau source de l'appel ; dt : seuil de détection ;
      // callBandwidthHz : largeur de l'appel (le bruit compte dans cette largeur) ;
      // visualScale : exagération des distances à l'écran (documentée : la vraie portée serait invisible).
      { id: 'blue', name: 'Rorqual bleu', latin: 'Balaenoptera musculus', enabled: true, groups: 30, band: 'low', sl: 186, dt: 6, callBandwidthHz: 5, callIntervalSec: 14, minDepthM: 200, speedKmh: 5, visualScale: 1 },
      { id: 'fin', name: 'Rorqual commun', latin: 'Balaenoptera physalus', enabled: true, groups: 40, band: 'low', sl: 189, dt: 6, callBandwidthHz: 10, callIntervalSec: 10, minDepthM: 100, speedKmh: 6, visualScale: 1 },
      { id: 'humpback', name: 'Baleine à bosse', latin: 'Megaptera novaeangliae', enabled: true, groups: 40, band: 'mid', sl: 172, dt: 6, callBandwidthHz: 100, callIntervalSec: 6, minDepthM: 20, speedKmh: 5, visualScale: 4 },
      { id: 'sperm', name: 'Cachalot', latin: 'Physeter macrocephalus', enabled: true, groups: 30, band: 'high', sl: 175, dt: 8, callBandwidthHz: 5000, callIntervalSec: 4, minDepthM: 1000, speedKmh: 4, visualScale: 10 },
      { id: 'orca', name: 'Orque', latin: 'Orcinus orca', enabled: true, groups: 30, band: 'high', sl: 165, dt: 4, callBandwidthHz: 2000, callIntervalSec: 5, minDepthM: 10, speedKmh: 8, visualScale: 20 },
    ],
  },

  server: {
    port: 8787,
    snapshotHz: 1, // instantanés envoyés au client par seconde
  },
}
