// La carte du vacarme — configuration par défaut.
//
// Ce fichier est la référence : chaque paramètre y est commenté.
// Surcharges, dans l'ordre : config/expo.json5 (si VACARME_MODE=expo), puis
// config/local.json5 (écrit par le panneau de réglage, ignoré par git).
// Le serveur recharge ces fichiers à chaud : modifiez, enregistrez, l'image suit.
{
  // Profil physique fixe ; les anciennes surcharges acoustiques locales sont ignorées en référence.
  // Pour expérimenter : science.mode = 'experimental' (résultats signalés comme tels).
  // Écarts mesurés publiés par la validation (docs/VALIDATION_PROTOCOLE.md) ; absent = « non validé ».
  science: { mode: 'reference', validationSummary: 'data/science/validation-summary.json' },
  display: {
    // Cible d'affichage : "screen" (écran du portable) ou "projector" (Epson EB-990U).
    // Surchargeable par l'URL : ?display=projector
    target: 'screen',
    // Mode de rendu : 'flat' (carte plate), 'globe' (globe à l'écran), 'hemisphere' (demi-sphère + projecteur),
    // 'equirect' (texture monde brute, pour TouchDesigner / MapMap), 'fisheye'. Touche O : cycle ; G : plat ↔ globe.
    mode: 'flat',
    // Profil de qualité (voir qualityProfiles). Surchargeable par l'URL : ?quality=light
    quality: 'expo',
    // 'night' : palette de l'installation ; 'day' : palette claire (continents lisibles). Touche J.
    theme: 'night',
  },

  qualityProfiles: {
    // La qualité change le rendu ; le profil de référence fixe la grille physique à 1024×512.
    expo: { physicsSimWidth: 1024, worldTextureWidth: 2048 },
    light: { physicsSimWidth: 768, worldTextureWidth: 1536 },
  },

  view: {
    flat: {
      centerLon: 30, // de la côte est américaine à la mer de Chine (en 3:2, 'cover' montre ~210° de longitude)
      latMin: -62, // on coupe l'océan Austral profond et l'Antarctique…
      latMax: 78, // …et la banquise arctique
      fit: 'cover', // 'cover' remplit l'écran (rogne les bords en longitude), 'contain' montre tout
    },
    // Exploration : molette = zoom, glisser = déplacer, double-clic ou R = recadrer.
    // Le zoom interpole la grille physique commune ; il ne lance aucune simulation indépendante.
  },

  // Globe : la Terre tourne lentement sous un regard fixe (modes globe, hemisphere, fisheye).
  globe: {
    periodMinutes: 12, // un tour en 12 minutes
    viewLatDeg: 25, // l'hémisphère nord, où le trafic est le plus dense, est un peu tourné vers le public
    startLonDeg: 0,
    // Ralentissements (artistiques) quand une zone passe face au public :
    dwell: [
      { name: 'Manche et mer du Nord', lonDeg: 2, widthDeg: 25, slowdown: 0.35 },
      { name: 'Détroit de Malacca et mer de Chine', lonDeg: 110, widthDeg: 30, slowdown: 0.4 },
    ],
    limbShading: 0.45, // à l'écran : relief du globe ; au projecteur, la sphère physique s'en charge
    screenSize: 0.92,
  },

  // Demi-sphère bombée, un seul projecteur (Epson EB-990U) dans son axe. Calibration sur place : touche C (mire).
  hemisphere: {
    distanceRatio: 5.5, // d/R : ex. sphère de 1 m (R = 0,5 m) et projecteur à 2,75 m
    throwRatio: 1.6, // EB-990U : 1,39 (grand angle) à 2,23 (télé)
    shiftX: 0,
    shiftY: 0, // décalage fixe de l'objectif (à mesurer sur place)
    scale: 1.0, // ajustement fin du diamètre du disque
    rollDeg: 0,
    edgeCompensation: 0.6, // la lumière arrive rasante au bord : on renforce, plafonné
    maxGain: 2.5,
    edgeSoftness: 0.06, // fondu du bord du disque (pas de lumière sur le mur)
  },

  fisheye: { fovDeg: 180, model: 'equidistant' },

  // Rendu final (communs aux deux cibles, puis surchargés dans `targets`).
  render: {
    renderScale: 0.75, // fraction de la résolution native (les ondes sont douces : l'agrandissement ne se voit pas)
    exposure: 1.0,
    gamma: 1.0,
    blackLift: 0.0, // relève le noir (0–1)
    vignette: 0.25,
    dither: true, // évite les bandes dans les dégradés sombres
  },

  // Palette : fond noir profond, lumière froide pour les ondes.
  palette: {
    background: '#000000',
    oceanShallow: '#030a10',
    oceanDeep: '#000102',
    bathyRelief: 0.4, // relief du fond marin, à peine perceptible
    land: '#000000',
    coast: '#1b2a36',
    coastOpacity: 0.55,
    unknownDim: 0.4, // zones jamais observées par l'AIS : dans l'ombre (terra incognita)
    glow: '#5f9fc4', // lueur d'accumulation : là où le bruit dure, l'océan s'illumine
    fog: '#0b1117', // brouillard de la terra incognita : plus sombre que le calme connu, mais texturé
    wave: '#cfeaff',
    ship: '#e8f4ff',
  },

  // Mode jour (touche J) : remplace la palette ci-dessus champ par champ. Choix artistiques : l'océan reste
  // assez sombre pour que les ondes et la lueur (additives) se lisent, les terres sont claires.
  dayPalette: {
    background: '#0e1a24',
    oceanShallow: '#3f7a98',
    oceanDeep: '#163a56',
    bathyRelief: 0.6,
    land: '#cfc7b4',
    coast: '#4e4a40',
    coastOpacity: 0.8,
    unknownDim: 0.8,
    glow: '#a6dcf5',
    fog: '#24445c',
    wave: '#eef8ff',
    ship: '#ffffff',
  },

  // Surcharges propres à chaque cible.
  targets: {
    // Écran du portable (IPS, vrai noir) : on peut descendre bas dans les noirs.
    screen: {
      render: { vignette: 0.3, blackLift: 0.0 },
    },
    // Projecteur LCD à lampe : noir gris ; pas de vignettage (géré par le masque du disque au J6).
    projector: {
      render: { renderScale: 1.0, vignette: 0.0, gamma: 1.1 },
      view: { flat: { fit: 'contain' } },
    },
  },

  // Une seule horloge pour le replay, les sources synthétiques, les fronts et les cétacés.
  // Le direct impose toujours ×1 ; le facteur choisi est conservé pour le replay/la simulation.
  playback: { timeScale: 1 },

  // Fronts du champ acoustique : augmentation sur le fond dans la bande sélectionnée.
  // Visibilité nulle ≤ +1 dB, pleine à +10 dB (convention graphique, pas un seuil biologique).
  waves: {
    band: 'low', // 'low' : 10–40 Hz ; 'mid' : 100–500 Hz ; 'high' : 1–10 kHz
    brightness: 2.8, // luminosité, sans modifier le seuil de visibilité
    relief: 0.25,
  },

  ships: {
    visible: true,
    pointSize: 2.2, // en pixels CSS
    opacity: 0.7,
  },

  // Bandes d'analyse acoustique (Hz) — utilisées par le champ physique (J3).
  // Bandes d'analyse. Le bruit naturel de chaque bande (naturalDb) est calculé par le serveur à partir du
  // modèle `ambient` ci-dessous ; on peut le forcer en ajoutant naturalDb (à documenter alors).
  bands: [
    { id: 'low', fMin: 10, fMax: 40 }, // rorqual bleu, rorqual commun
    { id: 'mid', fMin: 100, fMax: 500 }, // baleine à bosse
    { id: 'high', fMin: 1000, fMax: 10000 }, // orque, cachalot
  ],

  // Bruit ambiant naturel (sans navires) : turbulence + vent + agitation thermique, modèle empirique de
  // Coates (1990) repris par Stojanovic (2007) et Lucani et al. (2008, éq. 4–8). La composante « trafic
  // lointain » est exclue : les navires sont modélisés un par un. Voir docs/REVUE_SCIENTIFIQUE.md §4.5.
  ambient: {
    windSpeedMs: 5, // choix : mer modérée (haut de l'échelle 3 de Beaufort). Donne 83,8 / 88,1 / 93,2 dB.
  },

  // Champ de bruit physique : grille calibrée en dB (voir docs/MODELE_PHYSIQUE.md).
  // Les pertes ci-dessous s'appliquent à l'identique au bruit des navires ET aux appels des cétacés.
  physics: {
    enabled: true,
    energyTauSec: 6, // moyenne de l'énergie : lisse les fluctuations des sources
    // Eau peu profonde (< 200 m, rien au-delà de 400 m) : perte par rebond × rebonds par km,
    // rebonds/km = 1000·tan θ / (2h). Seul le produit (perte × tan θ) compte. Calé (pas mesuré) pour que la
    // perte totale reproduise l'« étalement pratique » 15·log r entre 10 et 50 km par 50–100 m de fond :
    // 0,09 dB/rebond à θ = 10° → ≈ 0,08 dB/km par 100 m de fond, 0,16 par 50 m, 0,4 par 20 m.
    bottomBounceLossDb: 0.09,
    grazingAngleDeg: 10,
    // Coupure modale (guide de Pekeris) : f_c = c / (4h·√(1 − c²/c_b²)) ; c_b = 1 700 m/s (fond sableux, empirique).
    sedimentSoundSpeed: 1700,
    cutoffLossDbPerKm: 5, // sous la coupure, aucun mode ne se propage : extinction en quelques km (valeur empirique)
    extraLossDbPerKm: 0, // aucune perte arbitraire (l'ancienne valeur 0,004 dB/km, non sourcée, est retirée)
  },

  // Accumulation : l'océan se « sature » progressivement là où le trafic dure.
  accumulation: {
    bandWeights: { low: 0.45, mid: 0.4, high: 0.15 },
    quietDb: 95, // sous ce niveau, noir (le bruit naturel est vers 88–92 dB)
    saturationDb: 125, // pleine lueur
    gamma: 1.3,
    riseMinutes: 2, // la saturation s'installe en quelques minutes
    fallMinutes: 20, // et s'efface lentement : l'océan garde la trace
    strength: 0.9,
  },

  // Terra incognita : zones où l'AIS ne voit rien. Matière propre, distincte du calme connu.
  incognita: {
    fog: 0.7, // brouillard lent (sa couleur reste très sombre : palette.fog)
    scaleDeg: 9,
    drift: 0.6,
    grain: 0.25, // grain fin, visible même au projecteur (noir gris)
    waveKeep: 0.35, // les ondes y entrent, mais s'y estompent : on entend sans voir
  },

  // Mode simulation (navires synthétiques sur les routes maritimes).
  simulation: {
    shipCount: 5000,
    // Vitesse du temps : playback.timeScale (commun à toute la scène).
    fishingFraction: 0.12, // part de navires de pêche (errance près des côtes)
    laneWidthKm: 25, // dispersion latérale autour des routes
    seed: 42,
  },

  // Choix de la source de navires.
  source: {
    mode: 'auto', // 'auto' : direct (aisstream) si possible, sinon replay, sinon simulation
    liveSilenceSec: 60, // silence du direct avant bascule
    liveRecoverSec: 20, // bonne santé requise avant de revenir au direct
    liveMinShips: 300, // au démarrage, on attend d'avoir assez de navires avant d'afficher le direct
    // Navires affichés (touche N, ou panneau) : 'real' (AIS direct, replay, simulation par routes en secours),
    // 'estimated' (navires estimés d'après la densité mondiale Global Fishing Watch, voir estimated ci-dessous),
    // 'mixed' (réels là où l'AIS couvre, estimés ailleurs : la terra incognita disparaît).
    ships: 'real',
    coverageThreshold: 0.15, // mode mixte : couverture (0–1) sous laquelle une cellule de 1° reçoit des navires estimés
  },

  // Navires estimés : nombre et position tirés de la présence AIS mondiale (terrestre + satellite) de Global
  // Fishing Watch, navires en route (≥ 2 nœuds), moyenne sur 30 jours : data/density (uv run tools/build_presence.py).
  // L'effectif est SOURCÉ (λ = heures de présence / durée = navires présents en moyenne) ; le mouvement est synthétique.
  // Statut des valeurs : docs/REVUE_SCIENTIFIQUE.md (navires estimés).
  estimated: {
    dir: 'data/density',
    // Vitesse du temps : playback.timeScale.
    maxShips: 60000, // plafond technique (≈ 51 000 en route en moyenne sur oct. 2026 ; le client en affiche 70 000 au plus) ; s'il est atteint, le diagnostic le signale
    lifetimeHours: 24, // empirique : un navire renaît ailleurs au bout d'un jour simulé en moyenne (renouvelle la répartition)
    lookAheadKm: 30, // empirique : distance d'anticipation pour suivre les couloirs de densité
    // Répartition des groupes GFW en classes JOMOPANS-ECHO. GFW ne distingue pas vraquiers et pétroliers :
    // cargo_fast (≥ 15 nœuds) → porte-conteneurs (même règle que la classification AIS : > 16 nœuds) ;
    // le reste : ORDRES DE GRANDEUR (flotte mondiale en nombre de navires, CNUCED, Review of Maritime Transport).
    classMix: {
      cargo_fast: { container: 1 },
      cargo_slow: { bulker: 0.6, tanker: 0.4 },
      passenger: { passenger: 0.9, cruise: 0.1 },
      fishing: { fishing: 1 },
      other: { other: 0.6, tug: 0.4 },
    },
    seed: 7,
  },

  // AIS en direct (aisstream.io). La clé se lit dans .env : AISSTREAM_API_KEY=…
  live: {
    url: 'wss://stream.aisstream.io/v0/stream',
    staleAfterMin: 10, // au-delà : position extrapolée, marquée « ancienne »
    maxExtrapolateMin: 30, // extrapolation à l'estime au plus 30 min (couverture côtière : un navire qui sort de portée continue sa route)
    evictAfterMin: 180, // oubli après 3 h sans nouvelles
    includeMoored: false, // les navires à quai sont presque silencieux : non envoyés au rendu
  },

  // Replay de fichiers enregistrés (.ndjson.gz) — enregistrements du serveur ou archives converties (tools/convert_ais.py).
  replay: {
    path: 'data/replays', // fichier ou dossier ; pour rejouer vos propres enregistrements : 'data/recordings'
    // Vitesse du temps : playback.timeScale.
    loop: true,
  },

  // Enregistrement du flux direct, pour le rejouer le jour de l'exposition.
  recorder: {
    enabled: true,
    dir: 'data/recordings', // un fichier par heure : AAAA-MM-JJ/HH.ndjson.gz
    minIntervalSec: 30, // une position par navire toutes les 30 s au plus (≈ 1/10 du volume brut)
  },

  // Carte de couverture AIS (où l'on « voit » des navires).
  coverage: {
    halfLifeHours: 12, // mémoire : une zone non revue depuis 12 h perd la moitié de son score
    gainPerMessage: 0.25,
    simulation: 'full', // en simulation : 'full' (tout observé) ou 'recorded' (dernière couverture réelle)
  },

  // Cétacés (J4) : groupes simulés dans leurs habitats (AquaMaps), espace de communication
  // (équation du sonar, bruit local ; principe : Clark et al. 2009) et liens entre groupes.
  // Statut de chaque valeur (sourcée, empirique, artistique) : docs/REVUE_SCIENTIFIQUE.md §6.
  whales: {
    enabled: true,
    // Vitesse du temps : playback.timeScale ; vitesses physiques en speedKmh ci-dessous.
    habitatThreshold: 0.35,
    useSightings: true,
    color: '#f2dcc2', // teinte chaude et pâle : le vivant, distinct de la lumière froide du bruit
    space: {
      fill: 0.09, // remplissage de l'espace de communication
      contour: 0.6, // contour (là où l'appel cesse d'être audible)
      softnessDb: 10, // fondu du remplissage vers le contour
      markerSize: 6, // point du groupe (pixels CSS) ; il s'illumine à chaque appel
    },
    links: {
      enabled: true,
      hysteresisDb: 2, // pas de clignotement autour du seuil
      breakSec: 5, // le fil s'effiloche puis s'éteint en quelques secondes
      reknitSec: 14, // il se retisse plus lentement
      ghostSec: 180, // trace fantôme du lien perdu
      intensity: 0.9,
      ghost: 0.12,
      pulseSpeed: 0.3, // l'appel parcourt le fil en ~3 s
    },
    species: [
      // band : bande du champ physique ; sl : niveau source de l'appel ; dt : seuil de détection ;
      // callBandwidthHz : largeur de l'appel (le bruit compte dans cette largeur) ;
      // visualScale : exagération des distances à l'écran (documentée : la vraie portée serait invisible).
      // Niveaux sources (sl) : valeurs publiées, voir docs/REVUE_SCIENTIFIQUE.md §6.
      //   bleu 189 ± 3 et commun 189 ± 4 dB (Širović et al. 2007, JASA 122:1208) ;
      //   baleine à bosse : unités de chant 151–173 dB (Au et al. 2006) → 172 (haut de la fourchette) ;
      //   cachalot (codas) : médiane 161 dB rms (Jacobs et al. 2024, JEB) ;
      //   orque : appels stéréotypés 152,6 ± 5,9 dB (Miller 2006) → 153.
      // dt, callBandwidthHz : choix de l'auteur (non sourcés), à discuter.
      { id: 'blue', name: 'Rorqual bleu', latin: 'Balaenoptera musculus', enabled: true, groups: 30, band: 'low', sl: 189, dt: 6, callBandwidthHz: 5, callIntervalSec: 14, minDepthM: 200, speedKmh: 5, visualScale: 1 },
      { id: 'fin', name: 'Rorqual commun', latin: 'Balaenoptera physalus', enabled: true, groups: 40, band: 'low', sl: 189, dt: 6, callBandwidthHz: 10, callIntervalSec: 10, minDepthM: 100, speedKmh: 6, visualScale: 1 },
      { id: 'humpback', name: 'Baleine à bosse', latin: 'Megaptera novaeangliae', enabled: true, groups: 40, band: 'mid', sl: 172, dt: 6, callBandwidthHz: 100, callIntervalSec: 6, minDepthM: 20, speedKmh: 5, visualScale: 4 },
      { id: 'sperm', name: 'Cachalot', latin: 'Physeter macrocephalus', enabled: true, groups: 30, band: 'high', sl: 161, dt: 8, callBandwidthHz: 5000, callIntervalSec: 4, minDepthM: 1000, speedKmh: 4, visualScale: 40 },
      { id: 'orca', name: 'Orque', latin: 'Orcinus orca', enabled: true, groups: 30, band: 'high', sl: 153, dt: 4, callBandwidthHz: 2000, callIntervalSec: 5, minDepthM: 10, speedKmh: 8, visualScale: 60 },
    ],
  },

  // Son (J5). Un seul bus de sortie + limiteur, sans spatialisation (prévue plus tard dans client/src/audio/output.ts).
  // Le navigateur n'autorise le son qu'après un geste (clic, touche) ; en kiosque : --autoplay-policy=no-user-gesture-required.
  audio: {
    enabled: true,
    master: 0.7,
    ships: {
      volume: 0.7,
      voices: 12, // les navires les plus forts de la vue
      refDb: 190, // niveau source donnant le volume plein
      edgeAttenuationDb: 18, // on entend surtout le centre de la vue : zoomer = tendre l'oreille
      hysteresisDb: 3, // pas de valse des voix
      transposeOctaves: 2, // ×4 : audible sur les haut-parleurs d'un portable ; avec un caisson, 0 ou 1
    },
    bed: { volume: 0.6 }, // nappe : le grondement de la masse, suit le bruit moyen de la zone affichée
    whales: {
      volume: 0.8,
      voices: 4, // appels simultanés au plus
      answerDelaySec: 0.6, // pause avant de répondre, une fois l'appel arrivé le long du fil (lien rompu : pas de réponse)
      // Facteur de fréquence : rorquals ×5 (leurs 15–25 Hz deviennent 75–125 Hz), les autres tels quels.
      transpose: { blue: 5, fin: 5, humpback: 1, sperm: 1, orca: 1 },
    },
  },

  server: {
    port: 8787,
    snapshotHz: 1, // instantanés envoyés au client par seconde
  },
}
