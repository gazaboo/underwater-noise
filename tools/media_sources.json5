        recordedAt: '2023-12-01T15:00:36Z',
        place: 'Smooth Ridge, au large de la baie de Monterey (Californie), ≈ 900 m de fond',
        instrument: 'hydrophone MARS, fichier décimé à 2 kHz',
      },
      license: 'CC-BY 4.0',
      credit: 'Pacific Ocean Sound Recordings, MBARI (CC-BY 4.0), consulté le 25 oct. 2026 sur registry.opendata.aws/pacific-sound',
      fetch: {
        type: 'wav-range',
        url: 'https://pacific-sound-2khz.s3.amazonaws.com/2023/12/MARS-20231201T000000Z-2kHz.wav',
        startSec: 54036, // 15:00:36 ; journée du notebook MBARI « Fin Call Index »
        durationSec: 34,
      },
      // Passe-bas : retire une raie continue à ≈ 105 Hz (instrument ou navire lointain).
      prepare: { highpassHz: 10, lowpassHz: 45, fadeMs: 300, peakDb: -3 },
      spectrogram: { fMinHz: 5, fMaxHz: 60 },
      notes: 'Infrason : lu transposé ×5 (hauteur et durée), choix artistique [A]. Les impulsions sont espacées d\'environ 23 s.',
    },
