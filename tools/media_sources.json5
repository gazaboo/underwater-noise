// Sources des sons de la carte : écrites à la main, lues par tools/build_media.py.
//
// Une entrée = un extrait d'un vrai enregistrement. Champs :
//   subject     : { species: 'blue' | 'fin' | 'humpback' | 'sperm' | 'orca' } ou { lieu: '<id>' }
//   origin      : d'où vient le son (source, URL de la page, auteur, date, lieu, instrument)
//   license     : licence de la source, ou « accord personnel <date> »
//   credit      : texte de crédit à afficher
//   fetch       : 'wav-range' (plage d'octets d'un WAV PCM distant) ou 'file' (fichier court)
//   prepare     : filtres et normalisation [E] ; la hauteur n'est jamais modifiée ici
//   spectrogram : bande affichée (Hz)
//   status      : statut de l'extrait (S = sourcé)
//
// Choix des extraits (25 oct. 2026) : spectrogrammes regardés sur des fenêtres plus longues, puis un appel
// net retenu par espèce. Échantillon frugal : un extrait par espèce, deux pour le lieu PALAOA.
{
  sons: [
    {
      id: 'blue-ab-mars-20171101',
      subject: { species: 'blue' },
      title: 'Rorqual bleu : appels A puis B (chant du Pacifique Nord-Est)',
      origin: {
        source: 'MBARI, Pacific Ocean Sound Recordings (hydrophone de l\'observatoire câblé MARS)',
        url: 'https://registry.opendata.aws/pacific-sound/',
        author: 'Monterey Bay Aquarium Research Institute (MBARI)',
        recordedAt: '2017-11-01T05:03:06Z',
        place: 'Smooth Ridge, au large de la baie de Monterey (Californie), ≈ 900 m de fond',
        instrument: 'hydrophone MARS, fichier décimé à 2 kHz',
      },
      license: 'CC-BY 4.0',
      credit: 'Pacific Ocean Sound Recordings, MBARI (CC-BY 4.0), consulté le 25 oct. 2026 sur registry.opendata.aws/pacific-sound',
      fetch: {
        type: 'wav-range',
        url: 'https://pacific-sound-2khz.s3.amazonaws.com/2017/11/MARS-20171101T000000Z-2kHz.wav',
        startSec: 18186, // 05:03:06 ; novembre 2017 = plus forte activité de chant sur 2015–2021 (notebook MBARI Blue A)
        durationSec: 84,
      },
      // Le passe-haut retire les impulsions de rorquals communs (15–25 Hz) présentes dans le même extrait,
      // et donc aussi la fondamentale du B (≈ 15 Hz) ; restent l'appel A (≈ 80–90 Hz) et la 3e harmonique du B (≈ 43 Hz).
      prepare: { highpassHz: 28, lowpassHz: 200, fadeMs: 400, peakDb: -3 },
      spectrogram: { fMinHz: 10, fMaxHz: 120 },
      notes: 'Infrason : inaudible tel quel. Lu transposé (audio.whales.transpose, ×5 : hauteur et durée), choix artistique [A].',
    },
    {
      id: 'fin-mars-20231201',
